---
const BASE = import.meta.env.BASE_URL || '/';

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href={BASE+ "icon_web.png"} />
		<meta name="generator" content={Astro.generator} />
		<!-- SEO -->
		<title>Stefano Alexandro | Desarrollador Backend</title>
		<meta name="description" content="Portafolio Web de Stefano Gonzales. Muestra de proyectos trabajados usando Java y C#. Experiencia en proyecto Freelancer y mentoria"/>
		<meta property="og:type" content="website"/>
		<meta property="og:title" content="Stefano Alexandro | Desarrollador Backend" />
		<meta
		property="og:description"
		content="Programador FullStack Peruano especializado en Java y C#. Experiencia en proyecto Freelancer y mentoria"
		/>

		<meta property="og:image" content="https://stefano41dev.github.io/portafolioweb/imageopengraph.png">
		<meta property="og:image:width" content="1200">
		<meta property="og:image:height" content="630">
		<meta property="og:image:type" content="image/png">
		<meta property="og:image:alt" content="Previsualización del portafolio de un desarrollador Java">

		<meta property="og:url" content="https://stefano41dev.github.io/portafolioweb/" />
		
		<!-- Fuente de texto:  SUSE Mono   -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=SUSE+Mono:ital,wght@0,100..800;1,100..800&display=swap" rel="stylesheet">
		<meta name="google-site-verification" content="Pu9pY3EaPdrCowXlO1Cpy6uw8Oe8T4nkzUGFP4QsRkc" />	
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
  		font-family: "SUSE Mono", sans-serif;
	}
	html {
  		scroll-behavior: smooth;
	}

</style>
